<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LINGui.ViewModels"
             x:Class="LINGui.Views.SectorViewerView"
             x:DataType="vm:SectorViewerVm">
    <Grid RowDefinitions="Auto,*">
        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#252526" Padding="8,4">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <CheckBox Content="Bit view" IsChecked="{Binding ShowBits}" VerticalAlignment="Center"/>
                <CheckBox Content="Hide inactive" IsChecked="{Binding HideInactive}" VerticalAlignment="Center"/>
                <Button Content="Clear" Command="{Binding ClearCommand}" Width="60"/>
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Foreground="Gray" Margin="8,0,0,0"/>
                <TextBlock Text="● Active" VerticalAlignment="Center" Foreground="#E0E0E0" FontSize="10" Margin="16,0,0,0"/>
                <TextBlock Text="● Changed" VerticalAlignment="Center" Foreground="#CC4444" FontSize="10"/>
                <TextBlock Text="● Inactive" VerticalAlignment="Center" Foreground="#555555" FontSize="10"/>
            </StackPanel>
        </Border>

        <!-- Rows -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SectorRowVm">
                        <Border IsVisible="{Binding RowVisible}" Padding="2,1" BorderBrush="#333337"
                                BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <!-- ID label -->
                                <TextBlock Text="{Binding Id}" Width="64" VerticalAlignment="Center"
                                           FontFamily="Consolas" FontSize="11"
                                           Foreground="{Binding RowForeground}"/>
                                <!-- Byte cells -->
                                <ItemsControl ItemsSource="{Binding Bytes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="2"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SectorByteVm">
                                            <Grid Margin="0,0,3,0">
                                                <!-- Hex cell -->
                                                <Border Background="{Binding CellBackground}"
                                                        Width="26" Height="20" CornerRadius="2"
                                                        IsVisible="{Binding !ShowBits}">
                                                    <TextBlock Text="{Binding HexText}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontFamily="Consolas" FontSize="10"
                                                               Foreground="{Binding CellForeground}"/>
                                                </Border>
                                                <!-- Bit squares + hex label -->
                                                <StackPanel IsVisible="{Binding ShowBits}" Spacing="1">
                                                    <ItemsControl ItemsSource="{Binding Bits}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" Spacing="1"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:SectorBitVm">
                                                                <Border Width="10" Height="16"
                                                                        Background="{Binding BitBackground}"
                                                                        CornerRadius="1"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Text="{Binding HexText}"
                                                               HorizontalAlignment="Center"
                                                               FontFamily="Consolas" FontSize="9"
                                                               Foreground="{Binding CellForeground}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
