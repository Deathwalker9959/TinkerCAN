<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LINGui.ViewModels"
             x:Class="LINGui.Views.CanView"
             x:DataType="vm:CanViewModel">

    <Grid RowDefinitions="Auto,*">
        <!-- Connection Bar -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="8,4" Margin="4">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Port:" VerticalAlignment="Center" Foreground="#E0E0E0"/>
                <ComboBox ItemsSource="{Binding SelectedCanPort}" Width="120"/>
                <Button Content="Connect" Command="{Binding ConnectCanCommand}" Width="80"/>
                <Button Content="Disconnect" Command="{Binding DisconnectCanCommand}" Width="90"/>

                <TextBlock Text="Nom:" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#E0E0E0"/>
                <ComboBox ItemsSource="{Binding NomRateLabels}" SelectedIndex="{Binding NomRateIdx}" Width="80"/>
                <TextBlock Text="FD:" VerticalAlignment="Center" Foreground="#E0E0E0"/>
                <ComboBox ItemsSource="{Binding FdRateLabels}" SelectedIndex="{Binding FdRateIdx}" Width="70"/>

                <CheckBox Content="Silent" IsChecked="{Binding CanSilent}" VerticalAlignment="Center"/>
                <CheckBox Content="AutoRetx" IsChecked="{Binding CanAutoRetx}" VerticalAlignment="Center"/>

                <Button Content="Open CAN" Command="{Binding OpenCanCommand}" Width="95" Margin="12,0,0,0"/>
                <Button Content="Close CAN" Command="{Binding CloseCanCommand}" Width="95"/>
                <Button Content="Version" Command="{Binding GetVersionCommand}" Width="70"/>

                <TextBlock Text="{Binding CanStatusText}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="Gray"/>
            </StackPanel>
        </Border>

        <!-- Tabs -->
        <TabControl Grid.Row="1">
            <!-- Signal Tab -->
            <TabItem Header="Signal">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Border Grid.Row="0" Margin="4" Padding="8" BorderBrush="#3E3E42" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Type:" VerticalAlignment="Center" Width="60"/>
                                <ComboBox ItemsSource="{Binding FrameTypeLabels}" SelectedIndex="{Binding SigFrameTypeIdx}" Width="240"/>
                                <TextBlock Text="ID:" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                <TextBox Text="{Binding SigId}" Width="90"/>
                                <TextBlock Text="DLC:" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                <ComboBox ItemsSource="{Binding DlcOptions}" SelectedIndex="{Binding SigDlcIdx}" Width="70"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Data:" VerticalAlignment="Center" Width="60"/>
                                <TextBox Text="{Binding SigData}" Width="450"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Margin="4,0,4,4" Padding="8" BorderBrush="#3E3E42" BorderThickness="1">
                        <TextBox Text="{Binding SigModifier}" AcceptsReturn="True" FontFamily="Consolas"
                                 Background="#1C1C1C" Foreground="#E0E0E0"/>
                    </Border>

                    <Border Grid.Row="2" Margin="4,0,4,4" Padding="8" BorderBrush="#3E3E42" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Send Once" Command="{Binding SendSigOnceCommand}" Width="90"/>
                            <Button Content="▶ Loop" Command="{Binding StartSigLoopCommand}" IsEnabled="{Binding !SigRunning}" Width="80"/>
                            <Button Content="■ Stop" Command="{Binding StopSigLoopCommand}" IsEnabled="{Binding SigRunning}" Width="80"/>
                            <TextBlock Text="Interval:" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <TextBox Text="{Binding SigIntervalMs}" Width="80"/>
                            <TextBlock Text="ms" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Multi-Signal Tab -->
            <TabItem Header="Multi-Signal">
                <Grid RowDefinitions="Auto,*">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="4">
                        <Button Content="+ Add" Command="{Binding AddMultiRowCommand}" Width="70"/>
                        <Button Content="− Remove" Command="{Binding RemoveMultiRowCommand}" CommandParameter="{Binding #CanMultiGrid.SelectedItem}" Width="80"/>
                        <Button Content="▶ Start All" Command="{Binding StartMultiCommand}" IsEnabled="{Binding !MultiRunning}" Width="90"/>
                        <Button Content="■ Stop All" Command="{Binding StopMultiCommand}" IsEnabled="{Binding MultiRunning}" Width="90"/>
                        <TextBlock Text="{Binding MultiStatus}" VerticalAlignment="Center" Foreground="Gray"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" Name="CanMultiGrid" ItemsSource="{Binding MultiRows}" AutoGenerateColumns="False"
                              CanUserReorderColumns="False" CanUserResizeColumns="True" GridLinesVisibility="All">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" Width="50"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="60"/>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="90"/>
                            <DataGridTextColumn Header="DLC" Binding="{Binding Dlc}" Width="50"/>
                            <DataGridTextColumn Header="Data (hex)" Binding="{Binding Data}" Width="*"/>
                            <DataGridTextColumn Header="ms" Binding="{Binding IntervalMs}" Width="60"/>
                            <DataGridTextColumn Header="Modifier" Binding="{Binding Modifier}" Width="150"/>
                            <DataGridTextColumn Header="Sent" Binding="{Binding SentCount}" IsReadOnly="True" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Brute Force Tab -->
            <TabItem Header="Brute Force">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
                    <Border Grid.Row="0" Margin="4" Padding="8" BorderBrush="#3E3E42" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="ID from:" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding BfStart}" Width="70"/>
                                <TextBlock Text="to:" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding BfEnd}" Width="70"/>
                                <TextBlock Text="Step:" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                <TextBox Text="{Binding BfStep}" Width="50"/>
                                <TextBlock Text="(hex)" VerticalAlignment="Center"/>
                                <TextBlock Text="Delay:" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                <TextBox Text="{Binding BfDelay}" Width="70"/>
                                <TextBlock Text="ms" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="RX Timeout:" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding BfRxTimeout}" Width="70"/>
                                <TextBlock Text="ms" VerticalAlignment="Center"/>
                                <TextBlock Text="DLC:" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                <TextBox Text="{Binding BfDlc}" Width="70"/>
                                <TextBlock Text="Type:" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                <ComboBox ItemsSource="{Binding BfTypeLabels}" SelectedIndex="{Binding BfTypeIdx}" Width="180"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Payload:" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding BfData}" Width="300"/>
                                <TextBlock Text="(HEX or 'INC')" VerticalAlignment="Center" Foreground="Gray"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <CheckBox Content="Constant signal:" IsChecked="{Binding BfConstEnabled}"/>
                                <TextBlock Text="ID:" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding BfConstId}" Width="70"/>
                                <TextBlock Text="Data:" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding BfConstData}" Width="250"/>
                                <TextBlock Text="every" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding BfConstMs}" Width="70"/>
                                <TextBlock Text="ms" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="4">
                        <Button Content="▶ Start" Command="{Binding StartBruteCommand}" IsEnabled="{Binding !BfRunning}" Width="80"/>
                        <Button Content="■ Stop" Command="{Binding StopBruteCommand}" IsEnabled="{Binding BfRunning}" Width="80"/>
                        <Button Content="Export CSV" Command="{Binding ExportBruteCommand}" Width="90"/>
                    </StackPanel>

                    <ProgressBar Grid.Row="2" Value="{Binding BfProgress}" Minimum="0" Maximum="100" Height="20" Margin="4,0"/>
                    <TextBlock Grid.Row="3" Text="{Binding BfStatus}" Margin="8,4" Foreground="Gray"/>

                    <DataGrid Grid.Row="4" ItemsSource="{Binding BruteResults}" AutoGenerateColumns="False"
                              CanUserReorderColumns="False" CanUserResizeColumns="True" GridLinesVisibility="All" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="60"/>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="90"/>
                            <DataGridTextColumn Header="DLC" Binding="{Binding Dlc}" Width="50"/>
                            <DataGridTextColumn Header="Payload" Binding="{Binding Payload}" Width="*"/>
                            <DataGridTextColumn Header="ACK" Binding="{Binding Ack}" Width="60"/>
                            <DataGridTextColumn Header="Resp Data" Binding="{Binding RespData}" Width="180"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Log Tab -->
            <TabItem Header="Log">
                <Grid RowDefinitions="Auto,*">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="4">
                        <TextBlock Text="{Binding RxCount, StringFormat='RX: {0}'}" VerticalAlignment="Center" Foreground="Gray"/>
                        <TextBlock Text="{Binding TxCount, StringFormat='TX: {0}'}" VerticalAlignment="Center" Foreground="Gray" Margin="12,0,0,0"/>
                        <Button Content="Clear" Command="{Binding ClearLogCommand}" Width="60" Margin="12,0,0,0"/>
                        <CheckBox Content="Group by ID" IsChecked="{Binding GroupById}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding LogEntries}" AutoGenerateColumns="False"
                              CanUserReorderColumns="False" CanUserResizeColumns="True" GridLinesVisibility="All" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Seq}" Width="60"/>
                            <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="100"/>
                            <DataGridTextColumn Header="Dir" Binding="{Binding Dir}" Width="50"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="80"/>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="90"/>
                            <DataGridTextColumn Header="DLC" Binding="{Binding Dlc}" Width="50"/>
                            <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="60"/>
                            <DataGridTextColumn Header="Data" Binding="{Binding Data}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
